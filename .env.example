# ModelVerse environment template
#
# Everything is optional except what you actually use.
# NOTE: `.env` is gitignored but is NOT auto-loaded yet (no dotenv dependency).
# Until a server-side loader exists, export these in your shell or set them in
# your container orchestrator. Do not rename variables to VITE_* — the browser
# never reads env vars in this app (no bundler).

# --- Server ---
# Port the Express server listens on (default 3000)
# PORT=3000

# --- Auth (self-hosted auth module) ---
# Path of the JSON user store (gitignored file, created on first run)
# AUTH_STORE_FILE=./data/users.json
# Path of the HMAC secret used to sign session tokens
# AUTH_SECRET_FILE=./data/.auth-secret
# Allow public self-registration (default: admin-created users only)
# ALLOW_PUBLIC_REGISTER=false

# --- External / hosted engines ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Local engine hosts ---
# OLLAMA_HOST=http://127.0.0.1:11434
# LMSTUDIO_HOST=http://127.0.0.1:1234
# KOBOLDCPP_HOST=http://127.0.0.1:5001
# VLLM_HOST=http://127.0.0.1:8000

# --- Model discovery paths (scanner) ---
# OLLAMA_MODELS=
# LLMODELS_PATH=
# TRANSFORMERS_CACHE=
# HF_HOME=

# --- Vendor bootstrap (scripts/vendor.mjs) ---
# FORCE=1    # re-copy browser vendor libs from node_modules
