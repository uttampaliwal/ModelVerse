{
  "name": "modelverse",
  "version": "0.0.2",
  "description": "Modern Web UI for local LLM inference",
  "main": "server.js",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "postinstall": "node scripts/vendor.mjs",
    "start": "npm run build && node server.js",
    "dev": "tsc -p tsconfig.server.json && node --watch server.js",
    "build": "tsc && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "watch": "tsc --watch",
    "update-llama": "node scripts/update-llama.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --check \"public/src/*.ts\" \"src/**/*.ts\" \"server.ts\" \"tests/*.ts\" \"e2e/*.ts\" \"playwright.config.ts\"",
    "format:fix": "prettier --write \"public/src/*.ts\" \"src/**/*.ts\" \"server.ts\" \"tests/*.ts\" \"e2e/*.ts\" \"playwright.config.ts\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "benchmark": "node scripts/benchmark.mjs",
    "eval": "node scripts/evaluate.mjs",
    "package": "node scripts/package.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "express": "^5.3.0",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "mathjax": "^4.1.3",
    "pdfjs-dist": "^6.4.299",
    "semver": "^7.8.5",
    "ws": "^8.22.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.24.0",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.24.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.30.1",
    "vitest": "^3.1.1"
  }
}
